# Optional: the launcher asks for these on first run and writes %APPDATA%\G-reality\.env.local itself.
# To configure by hand, copy this file to .env.local next to G-reality.cmd (or to %APPDATA%\G-reality\.env.local).
# Required PostgreSQL (e.g. Neon) connection URL
DATABASE_URL=
# Optional direct (non-pooled) database URL, used for schema migrations
DATABASE_URL_DIRECT=
# Optional Gemini key and model; without a key, the keyword interpreter is used
GEMINI_API_KEY=
GEMINI_MODEL=
GREALITY_INTERPRETER=gemini
# Optional WSL CUDA virtual environment directory and distro (default Ubuntu)
GREALITY_GPU_VENV=
GREALITY_WSL_DISTRO=
