# Required Neon database connection URL
DATABASE_URL=
# Optional direct database connection URL
DATABASE_URL_DIRECT=
# Optional Gemini key and model; without a key, keyword interpretation is used
GEMINI_API_KEY=
GEMINI_MODEL=
GREALITY_INTERPRETER=gemini
# Optional WSL CUDA virtual environment directory and distro (default Ubuntu)
GREALITY_GPU_VENV=
GREALITY_WSL_DISTRO=
