# Copy to .env (git-ignored). Never commit real values. Never expose these to browser code.

# --- world-api (server side only) ---
# Pooled Neon connection string for the *development* branch. Obtained via the Neon CLI in Chunk 1.
DATABASE_URL=
# Direct (non-pooled) connection used only by the migration runner.
DATABASE_URL_DIRECT=

# --- companion (local process: world-api + gpu service) ---
GREALITY_BIND_HOST=127.0.0.1
GREALITY_PORT=8765
# Comma-separated browser origins allowed to call the companion. No wildcard.
GREALITY_ALLOWED_ORIGINS=http://localhost:5173
# Local asset cache directory (splat files). Defaults to %LOCALAPPDATA%\G-reality\assets when empty.
GREALITY_ASSET_DIR=

# --- language interpretation (Chunk 5; pick one, see docs/architecture/ARCHITECTURE.md §9) ---
# "claude-cli" uses the locally authenticated `claude -p` (no API key), "anthropic" uses the key below,
# "rules" is the offline deterministic parser.
GREALITY_INTERPRETER=claude-cli
ANTHROPIC_API_KEY=

# --- web (public, safe to expose; Vite inlines VITE_* into the bundle) ---
VITE_COMPANION_URL=http://127.0.0.1:8765
